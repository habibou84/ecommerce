{
    "name": "habibou84/socle",
    "description": "Briques communes à Jibiat (livraison) et Jibiat Marchand : montants, téléphones, SMS, signature des webhooks.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Jibiat\\Socle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jibiat\\Socle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jibiat\\Socle\\SocleServiceProvider"
            ]
        }
    }
}
