// Schéma de base de données : Jibiat Marchand (jibiat-marchand.com)
// Format DBML, à importer sur https://dbdiagram.io
//
// Conventions
// - PostgreSQL 16. Montants en entiers dans la devise de la boutique (FCFA : pas de décimales).
// - created_at / updated_at sur toutes les tables, non répétés ci-dessous (sauf quand un index les utilise). Les tables marquées
//   « journal » n'ont que created_at et ne sont jamais modifiées ni supprimées.
// - store_id = isolation multi-boutique (global scope Eloquent), présent sur toutes les tables métier,
//   y compris quand il pourrait se déduire d'une table parente (filtrage et index directs).
// - Statuts et types en varchar ; les valeurs sont des enums PHP (liste dans la note de chaque colonne).
// - Téléphones au format E.164 (+2250707070707). Poids en grammes (entiers).
// - Secrets (clés API, jetons, identifiants de paiement) chiffrés par le cast Laravel « encrypted ».

Project jibiat_marchand {
  database_type: 'PostgreSQL'
  Note: 'SaaS e-commerce multi-boutique : catalogue à variantes, stock, commandes, boutique en ligne, livreurs propres, transporteurs connectés (Delivery App), paiements multi-prestataires.'
}

// ═════════════════════════════ PLATEFORME, COMPTES ET ACCÈS ═════════════════════════════

Table plans {
  id bigint [pk, increment]
  code varchar(30) [unique, not null, note: 'free | starter | pro | business']
  name varchar [not null]
  monthly_price int [not null, default: 0]
  yearly_price int
  limits jsonb [not null, note: '{orders_per_month, products, members, couriers, carrier_connections, payment_accounts} ; null = illimité']
  features jsonb [not null, note: '{custom_domain, online_payment, whatsapp_api, ai_product, advanced_stats, merchant_api, multi_store…}']
  is_public boolean [default: true]
  sort smallint [default: 0]
}

Table users {
  id bigint [pk, increment]
  name varchar [not null]
  phone varchar(20) [unique, not null, note: 'identifiant de connexion ; un même compte peut appartenir à plusieurs boutiques']
  email varchar [unique]
  password varchar [note: 'null = connexion par OTP uniquement']
  phone_verified_at timestamp
  is_super_admin boolean [default: false, note: 'accès à admin.jibiat-marchand.com']
  status varchar(20) [default: 'active', note: 'active | suspended']
  locale varchar(5) [default: 'fr']
  last_login_at timestamp
  remember_token varchar
  deleted_at timestamp
}

Table stores {
  id bigint [pk, increment]
  owner_id bigint [ref: > users.id, not null]
  billing_store_id bigint [ref: > stores.id, note: 'boutique du même propriétaire dont l\'abonnement (offre Business) couvre celle-ci']
  host_store_id bigint [ref: > stores.id, note: 'boutique dont l\'adresse héberge celle-ci (gestion commune, page {adresse}/{path}) ; son propre sous-domaine redirige']
  slug varchar(60) [unique, not null, note: 'sous-domaine : {slug}.jibiat-marchand.com ; liste de mots réservés côté code']
  path varchar(40) [note: 'boutique hébergée : nom de sa page à l\'adresse de la boutique hôte (unique par hôte)']
  name varchar [not null]
  tagline varchar(160)
  logo_path varchar
  favicon_path varchar
  country char(2) [not null, default: 'CI']
  currency char(3) [not null, default: 'XOF']
  timezone varchar [not null, default: 'Africa/Abidjan']
  locale varchar(5) [default: 'fr']
  phone varchar(20)
  whatsapp_phone varchar(20) [note: 'bouton « Commander sur WhatsApp » et support client']
  email varchar
  address text
  place_id bigint [ref: > places.id]
  active_theme_id bigint [ref: > store_themes.id]
  storefront_enabled boolean [default: false, note: 'boutique en ligne ouverte au public (sinon page « ouvre bientôt », aperçu par lien signé)']
  online_payment varchar(20) [not null, default: 'off', note: 'off | optional (au choix du client) | deposit (acompte exigé) | required (tout en ligne)']
  deposit_percent smallint [note: 'acompte en % du total, arrondi aux 5 F supérieurs']
  free_shipping_above int [note: 'livraison offerte dès ce montant, toutes zones']
  marketing jsonb [note: '{meta_pixel_id, tiktok_pixel_id, ga4_id}']
  meta_capi_token text [note: 'chiffré : API Conversions de Meta']
  assignment_mode varchar(10) [not null, default: 'suggest', note: 'off | suggest | auto (expédition créée à la confirmation)']
  order_prefix varchar(10) [default: '#']
  next_order_number int [not null, default: 1001, note: 'incrémenté sous verrou (SELECT … FOR UPDATE)']
  require_order_confirmation boolean [default: true, note: 'les commandes passent par la file « à confirmer »']
  require_delivery_code boolean [default: false, note: 'code remis au client, saisi par le livreur']
  default_fee_payer varchar(20) [default: 'customer', note: 'customer | store']
  allow_backorder boolean [default: false, note: 'valeur par défaut des nouveaux produits']
  low_stock_threshold int [default: 3]
  status varchar(20) [not null, default: 'trial', note: 'trial | active | past_due | suspended | closed']
  suspended_reason varchar [note: 'motif donné par la console']
  billing_notices jsonb [note: 'avertissements déjà envoyés : rappel d’échéance, quota de commandes du mois']
  closed_at timestamp
  deleted_at timestamp
}

Table store_users {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  user_id bigint [ref: > users.id, not null]
  status varchar(20) [default: 'active', note: 'active | suspended']
  invited_by bigint [ref: > users.id]
  joined_at timestamp
  last_seen_at timestamp
  indexes {
    (store_id, user_id) [unique]
  }
  Note: 'Appartenance à une boutique. Rôles par boutique via spatie/laravel-permission en mode « teams » (team_id = store_id) : owner, manager, confirmation_agent, stock_keeper, cashier, courier.'
}

Table store_invitations {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  name varchar
  phone varchar(20) [not null]
  role varchar(30) [not null]
  extra_stores json [note: 'autres boutiques de la même adresse rejointes avec l\'invitation : [{store_id, role}]']
  token_hash varchar(64) [unique, not null]
  invited_by bigint [ref: > users.id]
  accepted_by bigint [ref: > users.id]
  expires_at timestamp [not null]
  accepted_at timestamp
  revoked_at timestamp
}

Table store_domains {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  hostname varchar [unique, not null, note: 'www.maboutique.ci ; sert uniquement la boutique publique']
  is_primary boolean [default: false, note: 'adresse canonique du site public (offre Pro, 3 domaines au plus)']
  verification_token varchar(64) [not null, note: 'TXT « _jibiat.{hostname} » à créer par le marchand, plus un CNAME (ou A pour un domaine nu) vers la plateforme']
  verified_at timestamp [note: 'contrôle DNS (bouton « Vérifier », puis domains:check chaque nuit)']
  ssl_status varchar(20) [default: 'pending', note: 'pending | active ; Caddy (on_demand_tls, route /_caddy/ask) n’émet un certificat que pour un domaine vérifié']
  last_checked_at timestamp
  last_error varchar
}

Table slug_history {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  old_slug varchar(60) [unique, not null]
  expires_at timestamp [not null, note: 'redirection 301 de l’ancien sous-domaine pendant 90 jours ; le slug redevient libre ensuite']
}

Table subscriptions {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  plan_id bigint [ref: > plans.id, not null]
  status varchar(20) [not null, note: 'trialing | active | past_due | cancelled | expired']
  billing_cycle varchar(10) [default: 'monthly', note: 'monthly | yearly']
  trial_ends_at timestamp
  current_period_start timestamp
  current_period_end timestamp
  cancel_at_period_end boolean [default: false]
  cancelled_at timestamp
  indexes {
    store_id
    (status, current_period_end)
  }
}

Table subscription_invoices {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  subscription_id bigint [ref: > subscriptions.id, note: 'abonnement créé ou prolongé par le paiement']
  plan_id bigint [ref: > plans.id, not null]
  number varchar(20) [unique, not null, note: 'JM-2026-000123']
  billing_cycle varchar(10) [not null, note: 'monthly | yearly']
  credit_amount int [note: 'valeur des jours payés non utilisés de l\'offre précédente (changement d\'offre)']
  credit_days smallint [note: 'jours ajoutés à la nouvelle offre grâce à ce crédit']
  amount int [not null, note: '0 pour des mois offerts par la console']
  status varchar(20) [not null, note: 'pending | paid | failed | cancelled | offered']
  period_start timestamp
  period_end timestamp
  provider varchar(20) [note: 'encaissé sur le compte de la plateforme (wave | cinetpay | paydunya)']
  method varchar(20)
  idempotency_key uuid [unique, not null, note: 'référence envoyée au prestataire']
  provider_reference varchar
  checkout_url varchar
  raw jsonb
  created_by bigint [ref: > users.id]
  paid_at timestamp
  Note: 'Paiement validé seulement après relecture chez le prestataire (retour, notification signée). Même offre : la période s’ajoute à la précédente.'
}

Table usage_counters {
  Note: 'Non créée : les quotas (commandes du mois, produits, membres…) sont comptés à la demande (PlanLimits).'
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  period date [not null, note: 'premier jour du mois']
  metric varchar(30) [not null, note: 'orders | ai_products | whatsapp_messages…']
  value int [not null, default: 0]
  indexes {
    (store_id, period, metric) [unique]
  }
  Note: 'Quotas des offres. Les limites « stock » (produits, membres, livreurs) se comptent directement.'
}

Table phone_verifications {
  id bigint [pk, increment]
  purpose varchar(20) [not null, note: 'signup | invitation | password_reset']
  phone varchar(20) [not null]
  store_id bigint [ref: > stores.id, note: 'boutique de l’invitation ou du mot de passe oublié']
  user_id bigint [ref: > users.id, note: 'compte concerné (mot de passe oublié)']
  token_hash varchar(64) [unique, not null, note: 'empreinte du jeton gardé par le navigateur']
  sms_code_hash varchar [note: 'code à 6 chiffres haché']
  sms_count smallint [default: 0]
  sms_sent_at timestamp
  attempts smallint [default: 0]
  payload text [note: 'chiffré : données à conserver jusqu’à la fin (nom de la boutique, mot de passe haché…)']
  ip varchar(45)
  verified_at timestamp
  completed_at timestamp
  expires_at timestamp [not null]
  created_at timestamp [not null]
  indexes {
    (phone, purpose)
    (phone, created_at)
  }
}

Table support_sessions {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  admin_id bigint [ref: > users.id, not null, note: 'administrateur de la plateforme (users.is_super_admin)']
  reason varchar [not null, note: 'visible par la boutique']
  started_at timestamp [not null]
  expires_at timestamp [not null, note: '60 minutes par défaut, 4 h au plus']
  ended_at timestamp
  ended_by bigint [ref: > users.id, note: 'la boutique peut mettre fin à l’accès']
  ip varchar(45)
  Note: 'Accès temporaire à la gestion avec le rôle « support » (sans abonnement, équipe ni comptes de paiement) ; propriétaire prévenu ; fin automatique (support:expire).'
}

Table admin_actions {
  id bigint [pk, increment]
  admin_id bigint [ref: > users.id, not null]
  store_id bigint [ref: > stores.id]
  action varchar(40) [not null, note: 'console_login | suspend | reactivate | extend_trial | offer | support_session | plan_updated']
  data jsonb
  ip varchar(45)
  created_at timestamp [not null]
  Note: 'Journal de la console du super administrateur.'
}

// Tables techniques Laravel non détaillées : personal_access_tokens (Sanctum), roles / permissions /
// model_has_roles / role_has_permissions (spatie, colonne team_id), activity_log (spatie/laravel-activitylog),
// jobs, failed_jobs, cache, sessions, notifications.

// ═════════════════════════════ GÉOGRAPHIE ET ZONES DE LIVRAISON ═════════════════════════════

Table places {
  id bigint [pk, increment]
  country char(2) [not null]
  parent_id bigint [ref: > places.id]
  type varchar(20) [not null, note: 'city | commune | neighborhood']
  name varchar [not null]
  slug varchar [not null]
  aliases jsonb [note: '["yop", "yopougon siporex"] : reconnaissance des saisies libres']
  latitude decimal(9,6)
  longitude decimal(9,6)
  store_id bigint [ref: > stores.id, note: 'null = référentiel de la plateforme ; sinon lieu ajouté par une boutique']
  is_active boolean [default: true]
  indexes {
    (country, parent_id)
    (store_id)
  }
  Note: 'Référentiel commun des lieux (ville › commune › quartier), alimenté par la plateforme. Les clients, les zones des boutiques et les correspondances avec les transporteurs pointent tous vers ces lieux : une correspondance « lieu → zone du transporteur » faite une fois sert à toutes les commandes.'
}

Table delivery_zones {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  name varchar [not null, note: 'ex. « Abidjan Nord », « Cocody », « Intérieur du pays »']
  type varchar(20) [default: 'local', note: 'local | shipping (expédition interurbaine, V2)']
  fee int [not null, default: 0, note: 'frais facturés au client']
  express_fee int
  free_above int [note: 'livraison offerte dès ce sous-total']
  eta_min_hours int
  eta_max_hours int
  eta_label varchar(60) [note: 'texte affiché : « Livré aujourd’hui si commandé avant 14 h »']
  is_active boolean [default: true]
  sort smallint [default: 0]
}

Table delivery_zone_places {
  delivery_zone_id bigint [ref: > delivery_zones.id, not null]
  place_id bigint [ref: > places.id, not null]
  store_id bigint [ref: > stores.id, not null]
  indexes {
    (delivery_zone_id, place_id) [pk]
    (store_id, place_id) [unique, note: 'un lieu appartient à une seule zone par boutique']
  }
}

// ═════════════════════════════ CATALOGUE ═════════════════════════════

Table products {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  origin_product_id bigint [ref: > products.id, note: 'produit d’origine si copié d’une autre boutique de l’adresse']
  title varchar [not null]
  slug varchar [not null]
  description text [note: 'HTML assaini']
  brand varchar
  status varchar(20) [not null, default: 'active', note: 'draft | active | archived']
  is_visible_online boolean [default: true]
  has_variants boolean [default: false, note: 'false = une seule variante par défaut']
  track_inventory boolean [default: true]
  allow_backorder boolean [default: false, note: 'vendre en rupture']
  requires_shipping boolean [default: true]
  is_fragile boolean [default: false]
  low_stock_threshold int [note: 'null = seuil de la boutique']
  price_min int [note: 'cache recalculé depuis les variantes (listes, tri, filtres)']
  price_max int
  seo_title varchar(70)
  seo_description varchar(160)
  ai_generated_at timestamp [note: 'fiche proposée par l’IA à partir d’une photo (V1)']
  published_at timestamp
  deleted_at timestamp
  indexes {
    (store_id, slug) [unique]
    (store_id, status)
  }
}

Table product_options {
  id bigint [pk, increment]
  product_id bigint [ref: > products.id, not null]
  name varchar(40) [not null, note: 'Taille, Couleur, Matière…']
  position smallint [not null, note: '1 à 3']
  indexes {
    (product_id, position) [unique]
  }
}

Table product_option_values {
  id bigint [pk, increment]
  option_id bigint [ref: > product_options.id, not null]
  value varchar(60) [not null]
  position smallint [not null]
  swatch varchar(7) [note: 'couleur #RRGGBB affichée dans le sélecteur']
  indexes {
    (option_id, value) [unique]
  }
}

Table product_variants {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  product_id bigint [ref: > products.id, not null]
  origin_variant_id bigint [ref: > product_variants.id, note: 'variante d’origine si le produit a été copié d’une autre boutique de l’adresse (la première de la chaîne)']
  option1_value_id bigint [ref: > product_option_values.id]
  option2_value_id bigint [ref: > product_option_values.id]
  option3_value_id bigint [ref: > product_option_values.id]
  title varchar [not null, note: '« Rouge / M » ; « Par défaut » pour un produit simple']
  sku varchar(60)
  barcode varchar(60)
  price int [not null]
  compare_at_price int [note: 'prix barré']
  cost_price int [note: 'coût d’achat (coût moyen pondéré mis à jour à chaque réception)']
  weight_g int
  image_id bigint [ref: > product_images.id, note: 'photo affichée quand la variante est choisie']
  position smallint [default: 0]
  is_default boolean [default: false]
  is_active boolean [default: true]
  deleted_at timestamp
  indexes {
    (product_id, option1_value_id, option2_value_id, option3_value_id) [unique, note: 'NULLS NOT DISTINCT']
    (store_id, sku) [unique, note: 'si sku non null']
    (store_id, barcode)
  }
  Note: 'Toute vente, tout stock et toute expédition portent sur une variante. Les colonnes option1..3 remplacent le JSONB envisagé dans le plan : contrainte d’unicité et jointures simples.'
}

Table product_images {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  product_id bigint [ref: > products.id, not null]
  path varchar [not null, note: 'original ; déclinaisons WebP générées en file d’attente']
  alt varchar
  width int
  height int
  position smallint [default: 0]
}

Table volume_prices {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  product_id bigint [ref: > products.id, not null]
  min_quantity int [not null]
  price int [not null, note: 'prix du lot de min_quantity articles']
  indexes {
    (product_id, min_quantity) [unique]
  }
  Note: 'Prix par quantité, toutes variantes du produit confondues : 3 pour 25 000 → 3 unités à 8 333 (total exact 25 000). Appliqué s’il est plus avantageux qu’une vente flash.'
}

Table collections {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  title varchar [not null]
  slug varchar [not null]
  description text
  image_path varchar
  type varchar(10) [default: 'manual', note: 'manual | smart (V1)']
  rules jsonb [note: 'collections automatiques : [{field: tag|price|stock|brand, op, value}]']
  sort_order varchar(20) [default: 'manual', note: 'manual | best_selling | newest | price_asc | price_desc']
  is_visible_online boolean [default: true]
  seo_title varchar(70)
  seo_description varchar(160)
  indexes {
    (store_id, slug) [unique]
  }
  Note: 'Les catégories du plan sont des collections (un seul concept pour le marchand).'
}

Table collection_products {
  collection_id bigint [ref: > collections.id, not null]
  product_id bigint [ref: > products.id, not null]
  position int [default: 0]
  indexes {
    (collection_id, product_id) [pk]
  }
}

Table tags {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  name varchar(40) [not null]
  color varchar(7)
  indexes {
    (store_id, name) [unique]
  }
}

Table taggables {
  tag_id bigint [ref: > tags.id, not null]
  taggable_type varchar(30) [not null, note: 'product | customer | order']
  taggable_id bigint [not null]
  indexes {
    (tag_id, taggable_type, taggable_id) [pk]
    (taggable_type, taggable_id)
  }
}

// ═════════════════════════════ STOCK ═════════════════════════════

Table stock_locations {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  name varchar [not null]
  type varchar(20) [not null, note: 'shop | warehouse | home | carrier_hub']
  place_id bigint [ref: > places.id]
  address text
  landmark varchar
  phone varchar(20)
  carrier_connection_id bigint [ref: > carrier_connections.id, note: 'type carrier_hub : stock déposé chez une entreprise de livraison']
  remote_hub_id varchar [note: 'identifiant de l’entrepôt chez le transporteur (pickup_hub_id)']
  is_pickup_point boolean [default: false, note: 'retrait en boutique possible']
  fulfills_online_orders boolean [default: true]
  priority smallint [default: 0, note: 'ordre de choix de l’emplacement qui prépare une commande']
  is_active boolean [default: true]
}

Table stock_levels {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  variant_id bigint [ref: > product_variants.id, not null]
  location_id bigint [ref: > stock_locations.id, not null]
  on_hand int [not null, default: 0, note: 'physiquement présent']
  reserved int [not null, default: 0, note: 'réservé par des commandes non expédiées ; disponible = on_hand - reserved']
  indexes {
    (variant_id, location_id) [unique]
    (store_id, location_id)
  }
  Note: 'Cache recalculable depuis stock_movements ; mis à jour dans la même transaction que le mouvement.'
}

Table stock_movements {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  variant_id bigint [ref: > product_variants.id, not null]
  location_id bigint [ref: > stock_locations.id, not null]
  type varchar(20) [not null, note: 'receipt | adjustment | count | reservation | release | shipment | return | damaged | transfer_out | transfer_in | carrier_sync']
  on_hand_change int [not null, default: 0]
  reserved_change int [not null, default: 0]
  on_hand_after int [not null]
  reserved_after int [not null]
  unit_cost int
  reference_type varchar(30) [note: 'order | shipment | return | stock_transfer | inventory_count | stock_receipt']
  reference_id bigint
  user_id bigint [ref: > users.id]
  note varchar
  created_at timestamp [not null]
  indexes {
    (variant_id, created_at)
    (location_id, created_at)
    (reference_type, reference_id)
  }
  Note: 'Journal.'
}

Table suppliers {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  name varchar [not null]
  phone varchar(20)
  country char(2)
  note text
}

Table stock_receipts {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  location_id bigint [ref: > stock_locations.id, not null]
  supplier_id bigint [ref: > suppliers.id]
  reference varchar(60)
  total_cost int
  received_at timestamp [not null]
  created_by bigint [ref: > users.id]
}

Table stock_receipt_items {
  id bigint [pk, increment]
  receipt_id bigint [ref: > stock_receipts.id, not null]
  variant_id bigint [ref: > product_variants.id, not null]
  quantity int [not null]
  unit_cost int
}

Table stock_transfers {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  from_location_id bigint [ref: > stock_locations.id, not null]
  to_location_id bigint [ref: > stock_locations.id, not null]
  status varchar(20) [not null, note: 'draft | in_transit | received | cancelled']
  reference varchar(60)
  shipped_at timestamp
  received_at timestamp
  created_by bigint [ref: > users.id]
}

Table stock_transfer_items {
  id bigint [pk, increment]
  transfer_id bigint [ref: > stock_transfers.id, not null]
  variant_id bigint [ref: > product_variants.id, not null]
  quantity int [not null]
  received_quantity int
}

Table inventory_counts {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  location_id bigint [ref: > stock_locations.id, not null]
  status varchar(20) [not null, note: 'in_progress | completed | cancelled']
  started_by bigint [ref: > users.id]
  completed_by bigint [ref: > users.id]
  completed_at timestamp
}

Table inventory_count_items {
  id bigint [pk, increment]
  count_id bigint [ref: > inventory_counts.id, not null]
  variant_id bigint [ref: > product_variants.id, not null]
  expected int [not null, note: 'on_hand au début du comptage']
  counted int
  indexes {
    (count_id, variant_id) [unique]
  }
}

// ═════════════════════════════ CLIENTS ═════════════════════════════

Table customers {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  name varchar
  phone varchar(20) [not null]
  phone2 varchar(20)
  email varchar
  source varchar(20) [note: 'online_store | manual | whatsapp | import | pos | api']
  accepts_marketing boolean [default: false, note: 'consentement aux messages promotionnels']
  verified_at timestamp [note: 'compte client activé (connexion par OTP)']
  note text
  blacklisted_at timestamp
  blacklist_reason varchar
  orders_count int [default: 0, note: 'compteurs recalculables, mis à jour par les événements de commande']
  delivered_count int [default: 0]
  refused_count int [default: 0, note: 'échecs imputables au client : refus, injoignable, faux numéro']
  total_spent int [default: 0]
  last_order_at timestamp
  deleted_at timestamp [note: 'suppression à la demande : données personnelles anonymisées']
  indexes {
    (store_id, phone) [unique]
    (store_id, last_order_at)
  }
}

Table customer_addresses {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  customer_id bigint [ref: > customers.id, not null]
  label varchar(40) [note: 'Maison, Bureau…']
  recipient_name varchar
  phone varchar(20)
  place_id bigint [ref: > places.id]
  address_line varchar
  landmark varchar [note: 'point de repère : « face pharmacie »']
  latitude decimal(9,6)
  longitude decimal(9,6)
  is_default boolean [default: false]
}

Table carts {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  token varchar(64) [unique, not null, note: 'cookie du visiteur']
  customer_id bigint [ref: > customers.id]
  name varchar
  phone varchar(20) [note: 'saisi en premier dans le formulaire : permet la relance du panier abandonné']
  discount_code varchar(40)
  utm jsonb [note: 'source, medium, campaign, fbclid, ttclid']
  status varchar(20) [default: 'active', note: 'active | converted | abandoned | expired']
  last_activity_at timestamp
  recovery_sent_at timestamp
  recovered_at timestamp
  order_id bigint [ref: > orders.id]
  indexes {
    (store_id, status, last_activity_at)
  }
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [ref: > carts.id, not null]
  variant_id bigint [ref: > product_variants.id, not null]
  quantity int [not null]
  indexes {
    (cart_id, variant_id) [unique]
  }
  Note: 'Les prix sont toujours recalculés au moment de la commande.'
}

// ═════════════════════════════ COMMANDES ═════════════════════════════

Table orders {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  number int [not null, note: 'affiché avec le préfixe : #1042']
  customer_id bigint [ref: > customers.id]
  source varchar(20) [not null, note: 'online_store | manual | whatsapp | facebook | instagram | tiktok | phone | import | pos | api']
  external_reference varchar(100) [note: 'référence de l’import ou de l’API']
  status varchar(25) [not null, note: 'pending_confirmation | confirmed | processing | shipped | completed | cancelled | returned']
  payment_status varchar(20) [not null, default: 'unpaid', note: 'unpaid | partially_paid | paid | partially_refunded | refunded']
  fulfillment_status varchar(20) [not null, default: 'unfulfilled', note: 'unfulfilled | partial | fulfilled | returned']
  // Instantané client et livraison
  customer_name varchar
  customer_phone varchar(20) [not null]
  delivery_method varchar(20) [not null, default: 'delivery', note: 'delivery | pickup']
  shipping_name varchar
  shipping_phone varchar(20)
  shipping_phone2 varchar(20)
  shipping_place_id bigint [ref: > places.id]
  shipping_place_label varchar [note: 'texte du lieu au moment de la commande']
  shipping_address varchar
  shipping_landmark varchar
  shipping_latitude decimal(9,6)
  shipping_longitude decimal(9,6)
  delivery_zone_id bigint [ref: > delivery_zones.id]
  pickup_location_id bigint [ref: > stock_locations.id, note: 'retrait en boutique']
  location_id bigint [ref: > stock_locations.id, note: 'emplacement qui prépare la commande (réservation du stock)']
  scheduled_date date
  time_slot varchar(20)
  // Montants
  subtotal int [not null, default: 0]
  discount_total int [not null, default: 0]
  shipping_fee int [not null, default: 0, note: 'facturé au client (0 si offert par la boutique)']
  total int [not null, default: 0]
  amount_paid int [not null, default: 0, note: 'somme des paiements réussis (acompte, en ligne, à la livraison)']
  amount_refunded int [not null, default: 0]
  cost_total int [note: 'coût d’achat des articles, pour la marge']
  deposit_required int [note: 'acompte exigé avant expédition']
  discount_code varchar(40)
  // Suivi
  conversion_sent_at timestamp [note: 'achat envoyé à l’API Conversions de Meta']
  customer_note text
  internal_note text
  risk_score smallint [note: '0 à 100 : historique de refus, doublon, numéro suspect']
  utm jsonb
  tracking_token varchar(32) [unique, note: 'lien public {slug}.jibiat-marchand.com/suivi/{token}']
  confirmed_at timestamp
  confirmed_by bigint [ref: > users.id]
  callback_at timestamp [note: 'relance prévue dans la file de confirmation']
  shipped_at timestamp
  completed_at timestamp
  cancelled_at timestamp
  cancel_reason varchar(30) [note: 'customer_refused | unreachable | wrong_number | out_of_stock | duplicate | fraud | customer_request | other']
  cancel_note varchar
  returned_at timestamp
  created_by bigint [ref: > users.id, note: 'null = commande passée par le client']
  created_at timestamp [not null]
  indexes {
    (store_id, number) [unique]
    (store_id, status, created_at)
    (store_id, customer_phone)
    (store_id, source, created_at)
  }
}

Table order_items {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  order_id bigint [ref: > orders.id, not null]
  variant_id bigint [ref: > product_variants.id, note: 'null = article libre ou variante supprimée']
  product_id bigint [ref: > products.id]
  // Instantané
  title varchar [not null]
  variant_title varchar [note: '« Rouge / M »']
  sku varchar(60)
  image_path varchar
  quantity int [not null]
  unit_price int [not null]
  compare_at_price int
  unit_cost int
  discount_amount int [not null, default: 0, note: 'part du code promo répartie sur la ligne']
  discount_id bigint [ref: > discounts.id, note: 'vente flash appliquée au prix']
  total int [not null]
  weight_g int
  requires_shipping boolean [default: true]
  stock_location_id bigint [ref: > stock_locations.id, note: 'emplacement où la quantité est réservée']
  fulfilled_quantity int [not null, default: 0]
  returned_quantity int [not null, default: 0]
}

Table order_events {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  order_id bigint [ref: > orders.id, not null]
  type varchar(40) [not null, note: 'created | edited | confirmed | confirmation_attempt | cancelled | payment_received | refunded | shipment_created | shipment_status | note | message_sent…']
  data jsonb [note: 'avant / après, détails']
  actor_type varchar(20) [not null, note: 'user | customer | courier | carrier | system']
  user_id bigint [ref: > users.id]
  created_at timestamp [not null]
  indexes {
    (order_id, created_at)
  }
  Note: 'Journal.'
}

Table order_confirmations {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  order_id bigint [ref: > orders.id, not null]
  channel varchar(20) [not null, note: 'call | whatsapp | sms | whatsapp_button (V1, automatique)']
  outcome varchar(20) [not null, note: 'confirmed | no_answer | wrong_number | refused | callback | changed']
  note varchar
  callback_at timestamp [note: 'relance planifiée']
  user_id bigint [ref: > users.id]
  created_at timestamp [not null]
  indexes {
    (order_id, created_at)
    (store_id, callback_at)
  }
  Note: 'Journal des tentatives de confirmation (file « à confirmer »).'
}

Table discounts {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  code varchar(40) [note: 'null = remise automatique (vente flash)']
  title varchar
  type varchar(20) [not null, note: 'percentage | fixed_amount | free_shipping (codes seulement) ; buy_x_get_y : V1']
  value int [not null, note: 'pourcentage ou montant']
  applies_to varchar(20) [default: 'all', note: 'all | collections | products']
  target_ids jsonb
  min_subtotal int
  usage_limit int
  per_customer_limit int
  used_count int [default: 0]
  starts_at timestamp
  ends_at timestamp
  is_active boolean [default: true]
  indexes {
    (store_id, code) [unique]
  }
  Note: 'Code en majuscules. Sans code : vente flash (date de fin obligatoire, compte à rebours).'
}

Table discount_usages {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  discount_id bigint [ref: > discounts.id, not null]
  order_id bigint [ref: > orders.id, not null]
  customer_id bigint [ref: > customers.id]
  amount int [not null, note: 'remise accordée sur cette commande']
  created_at timestamp [not null]
  indexes {
    (discount_id, order_id) [unique]
  }
  Note: 'Recalculées à chaque modification de la commande, supprimées à l’annulation ; discounts.used_count en découle.'
}

Table returns {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  order_id bigint [ref: > orders.id, not null]
  shipment_id bigint [ref: > shipments.id, note: 'colis revenu (refus, échec) ou expédition retour']
  status varchar(20) [not null, note: 'requested | in_transit | received | closed | rejected']
  reason varchar(30) [note: 'refused | failed_delivery | defective | wrong_item | size | other']
  resolution varchar(20) [note: 'refund | exchange | store_credit | none']
  received_at timestamp
  received_by bigint [ref: > users.id]
}

Table return_items {
  id bigint [pk, increment]
  return_id bigint [ref: > returns.id, not null]
  order_item_id bigint [ref: > order_items.id, not null]
  quantity int [not null]
  condition varchar(20) [note: 'resellable | damaged']
  restock_location_id bigint [ref: > stock_locations.id, note: 'renseigné si remis en stock']
}

// ═════════════════════════════ PAIEMENTS ═════════════════════════════

Table payment_accounts {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  provider varchar(20) [not null, note: 'wave | cinetpay | paydunya (V1) ; hub2 | fedapay | paystack (V2)']
  label varchar
  credentials text [not null, note: 'chiffré : clés et identifiants du compte du marchand chez le prestataire']
  mode varchar(10) [default: 'live', note: 'test | live']
  webhook_uuid uuid [unique, not null, note: 'URL de notification : api.jibiat-marchand.com/webhooks/payments/{uuid}']
  fee_percent decimal(5,2) [note: 'taux saisi par le marchand (souvent négocié) : sert au simulateur et à estimer les frais quand le prestataire ne les donne pas']
  fee_fixed int [not null, default: 0]
  status varchar(20) [default: 'active', note: 'active | error | disabled']
  last_error varchar
  Note: 'Frais de retrait et délai de reversement : V2.'
}

Table payment_routes {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  method varchar(20) [not null, note: 'wave | orange_money | mtn_momo | moov_money | card']
  payment_account_id bigint [ref: > payment_accounts.id, not null]
  priority smallint [not null, default: 1, note: '1 = prestataire principal ; les suivants servent de secours']
  indexes {
    (store_id, method, payment_account_id) [unique]
  }
}

Table payments {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  order_id bigint [ref: > orders.id]
  payment_link_id bigint [ref: > payment_links.id]
  shipment_id bigint [ref: > shipments.id, note: 'paiement encaissé à la livraison']
  kind varchar(20) [not null, note: 'online | deposit | cod_cash | cod_mobile | manual | carrier_cod']
  payment_account_id bigint [ref: > payment_accounts.id, note: 'null pour espèces et encaissements manuels']
  provider varchar(20)
  method varchar(20) [not null, note: 'cash | wave | orange_money | mtn_momo | moov_money | card | bank | other']
  amount int [not null]
  fee int [note: 'frais réels du prestataire']
  currency char(3) [not null]
  status varchar(20) [not null, note: 'pending | succeeded | failed | cancelled | expired']
  provider_reference varchar
  checkout_url varchar
  idempotency_key uuid [unique, not null]
  raw jsonb [note: 'dernière réponse du prestataire']
  collected_by_courier_id bigint [ref: > couriers.id]
  paid_at timestamp
  failure_reason varchar
  created_at timestamp [not null]
  indexes {
    (provider, provider_reference)
    (order_id)
    (store_id, status, created_at)
  }
}

Table payment_links {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  order_id bigint [ref: > orders.id]
  token varchar(32) [unique, not null]
  amount int [not null]
  description varchar
  status varchar(20) [not null, default: 'open', note: 'open | paid | expired | cancelled']
  expires_at timestamp
  paid_at timestamp
  created_by bigint [ref: > users.id]
}

Table refunds {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  order_id bigint [ref: > orders.id, not null]
  payment_id bigint [ref: > payments.id]
  amount int [not null]
  method varchar(20) [not null, note: 'provider (remboursé par l’API, Wave : montant total seulement) | manual (rendu à la main)']
  reason varchar
  status varchar(20) [not null, note: 'succeeded | failed']
  provider_reference varchar
  refunded_at timestamp
  created_by bigint [ref: > users.id]
}

Table payment_webhook_receipts {
  id bigint [pk, increment]
  payment_account_id bigint [ref: > payment_accounts.id, not null]
  event_id varchar [not null, note: 'identifiant de notification du prestataire (ou hash du corps)']
  payload jsonb
  received_at timestamp [not null]
  processed_at timestamp
  error varchar
  indexes {
    (payment_account_id, event_id) [unique]
  }
  Note: 'Dédoublonnage. Une notification ne valide jamais un paiement seule : vérification par l’API du prestataire.'
}

// ═════════════════════════════ EXPÉDITIONS ═════════════════════════════

Table shipments {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  order_id bigint [ref: > orders.id, not null]
  sequence smallint [not null, default: 1, note: 'affiché #1042-1, envoyé comme merchant_reference']
  mode varchar(20) [not null, note: 'carrier | manual_carrier | own_courier']
  status varchar(25) [not null, note: 'requested | accepted | rejected | awaiting_pickup | in_transit | out_for_delivery | delivered | failed | rescheduled | returning | returned | cancelled | lost']
  origin_location_id bigint [ref: > stock_locations.id]
  // Transporteur
  carrier_connection_id bigint [ref: > carrier_connections.id]
  courier_id bigint [ref: > couriers.id, note: 'livreur de la boutique (mode own_courier)']
  carrier_tracking_code varchar(40) [note: 'tracking_code de Delivery App']
  carrier_tracking_url varchar [note: 'page de suivi du transporteur, donnée au client']
  carrier_status varchar(30) [note: 'statut brut du transporteur']
  idempotency_key uuid [unique, not null, note: 'en-tête Idempotency-Key de la création de course']
  // Argent
  cod_amount int [not null, default: 0, note: 'à encaisser auprès du client (reste dû de la commande)']
  collected_amount int [note: 'réellement encaissé']
  carrier_fee int [note: 'tarif du transporteur (devis puis montant réel)']
  fee_payer varchar(20) [default: 'customer', note: 'customer | store']
  // Colis et preuve
  weight_g int
  is_fragile boolean [default: false]
  delivery_code varchar(20) [note: 'code à donner au livreur (fourni par le transporteur)']
  proof_photo_url varchar(1000) [note: 'lien signé du transporteur']
  proof_photo_path varchar [note: 'photo prise par le livreur de la boutique (stockage privé)']
  attempts_count smallint [default: 0]
  failure_reason varchar
  rescheduled_to date
  note varchar
  requested_at timestamp
  picked_up_at timestamp
  delivered_at timestamp
  returned_at timestamp
  cancelled_at timestamp
  last_synced_at timestamp
  created_by bigint [ref: > users.id]
  indexes {
    (order_id, sequence) [unique]
    (store_id, status)
    (carrier_connection_id, carrier_tracking_code) [unique]
  }
  Note: 'V1 : shipment_items (expédition partielle), créneau de livraison.'
}

Table shipment_items {
  id bigint [pk, increment]
  shipment_id bigint [ref: > shipments.id, not null]
  order_item_id bigint [ref: > order_items.id, not null]
  quantity int [not null]
  indexes {
    (shipment_id, order_item_id) [unique]
  }
}

Table shipment_events {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  shipment_id bigint [ref: > shipments.id, not null]
  status varchar(25) [note: 'statut normalisé après l’événement']
  raw_status varchar(30) [note: 'statut du transporteur']
  source varchar(20) [not null, note: 'courier | carrier_webhook | carrier_sync | user | system']
  note varchar
  photo_path varchar
  latitude decimal(9,6)
  longitude decimal(9,6)
  user_id bigint [ref: > users.id]
  courier_id bigint [ref: > couriers.id]
  occurred_at timestamp [not null, note: 'horodatage source (peut précéder la réception)']
  created_at timestamp [not null]
  indexes {
    (shipment_id, occurred_at)
  }
  Note: 'Journal. photo_path, latitude, longitude, courier_id arrivent en phase 5 (livreurs propres).'
}

Table shipment_quotes {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  order_id bigint [ref: > orders.id, not null]
  carrier_connection_id bigint [ref: > carrier_connections.id, note: 'null = livreur propre (coût estimé)']
  amount int [not null]
  eta_hours int
  chosen boolean [default: false]
  created_at timestamp [not null]
  Note: 'Devis comparés pour une commande (comparateur, statistiques par transporteur).'
}

Table shipping_rules {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  name varchar
  priority smallint [not null]
  conditions jsonb [note: '{delivery_zone_ids, is_fragile, min_amount, max_amount, max_weight_g}']
  action varchar(20) [not null, note: 'own_courier | carrier | cheapest | fastest | manual']
  carrier_connection_id bigint [ref: > carrier_connections.id]
  is_active boolean [default: true]
  Note: 'Affectation automatique (V1) : la première règle qui correspond choisit le mode.'
}

// ═════════════════════════════ LIVREURS DE LA BOUTIQUE ═════════════════════════════

Table couriers {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  user_id bigint [ref: > users.id, note: 'compte de connexion à /livreur']
  name varchar [not null]
  phone varchar(20) [not null]
  vehicle_type varchar(20) [note: 'moto | bicycle | car | foot']
  pay_rule_id bigint [ref: > courier_pay_rules.id]
  cash_limit int [note: 'alerte au-delà de ce montant détenu']
  is_available boolean [default: true]
  status varchar(20) [default: 'invited', note: 'invited | active | inactive']
  note text
  indexes {
    (store_id, phone) [unique]
  }
}

Table courier_zones {
  courier_id bigint [ref: > couriers.id, not null]
  delivery_zone_id bigint [ref: > delivery_zones.id, not null]
  indexes {
    (courier_id, delivery_zone_id) [pk]
  }
}

Table courier_assignments {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  shipment_id bigint [ref: > shipments.id, not null]
  courier_id bigint [ref: > couriers.id, not null]
  status varchar(20) [not null, note: 'assigned | completed | cancelled | reassigned']
  assigned_by bigint [ref: > users.id]
  assigned_at timestamp [not null]
  completed_at timestamp
  Note: 'Historique de toutes les missions, y compris réassignées.'
}

Table delivery_runs {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  courier_id bigint [ref: > couriers.id, not null]
  date date [not null]
  status varchar(20) [note: 'planned | in_progress | done']
  Note: 'Tournées (V1).'
}

Table delivery_run_stops {
  id bigint [pk, increment]
  run_id bigint [ref: > delivery_runs.id, not null]
  shipment_id bigint [ref: > shipments.id, not null]
  sequence smallint [not null]
  indexes {
    (run_id, shipment_id) [unique]
  }
}

Table cash_collections {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  shipment_id bigint [ref: > shipments.id, not null]
  courier_id bigint [ref: > couriers.id, not null]
  payment_id bigint [ref: > payments.id]
  amount int [not null]
  method varchar(20) [default: 'cash', note: 'cash : détenu par le livreur ; mobile money : déjà chez la boutique']
  remittance_id bigint [ref: > courier_remittances.id, note: 'null = encore détenu par le livreur']
  collected_at timestamp [not null]
  indexes {
    (courier_id, remittance_id)
  }
}

Table courier_remittances {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  courier_id bigint [ref: > couriers.id, not null]
  expected_amount int [not null]
  received_amount int [not null]
  difference int [not null, note: 'received - expected ; un écart crée une écriture au grand livre']
  method varchar(20) [note: 'cash | wave | orange_money | mtn_momo | moov_money']
  received_by bigint [ref: > users.id]
  note varchar
  received_at timestamp [not null]
}

Table courier_pay_rules {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  name varchar [not null]
  type varchar(20) [not null, note: 'per_delivery | per_zone (daily | monthly : V1)']
  amount int [note: 'montant par livraison, par jour ou par mois']
  zone_amounts jsonb [note: '{delivery_zone_id: montant} pour per_zone']
  failed_attempt_amount int [default: 0]
}

Table courier_earnings {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  courier_id bigint [ref: > couriers.id, not null]
  shipment_id bigint [ref: > shipments.id]
  type varchar(20) [not null, note: 'delivery | failed_attempt | bonus | adjustment | advance']
  amount int [not null, note: 'négatif pour une avance ou une retenue']
  payout_id bigint [ref: > courier_payouts.id]
  note varchar
  created_by bigint [ref: > users.id]
  created_at timestamp [not null]
  Note: 'Journal.'
}

Table courier_payouts {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  courier_id bigint [ref: > couriers.id, not null]
  period_start date
  period_end date [not null]
  total int [not null]
  status varchar(20) [not null, note: 'draft | paid | cancelled']
  method varchar(20)
  reference varchar
  paid_at timestamp
  paid_by bigint [ref: > users.id]
  created_by bigint [ref: > users.id]
}

Table courier_locations {
  id bigint [pk, increment]
  courier_id bigint [ref: > couriers.id, not null]
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]
  accuracy_m smallint
  recorded_at timestamp [not null]
  indexes {
    (courier_id, recorded_at)
  }
  Note: 'Conservées 90 jours.'
}

// ═════════════════════════════ TRANSPORTEURS CONNECTÉS ═════════════════════════════

Table carrier_connections {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  driver varchar(20) [not null, note: 'delivery_app | manual | autres connecteurs (V2)']
  name varchar [not null, note: 'nom de l’entreprise de livraison']
  base_url varchar [note: 'https://{entreprise}.jibiat.com/api/public/v1']
  api_key text [note: 'chiffré']
  api_key_prefix varchar(12) [note: 'partie visible, pour l’affichage']
  scopes jsonb
  remote_account jsonb [note: 'réponse de GET /me (marchand, entreprise, portées de la clé)']
  webhook_uuid uuid [unique, not null, note: 'URL de réception : api.jibiat-marchand.com/webhooks/carriers/{uuid}']
  webhook_secret text [note: 'chiffré ; créé par API (§5.7) ou saisi à la main']
  remote_webhook_id varchar [note: 'abonnement créé chez le transporteur']
  contact_phone varchar(20) [note: 'transporteur sans API : numéro WhatsApp']
  settings jsonb [note: '{default_fee_payer, pickup_location_id, auto_create_on_confirm…}']
  status varchar(20) [not null, default: 'pending', note: 'pending | active | error | disabled']
  last_error varchar
  last_synced_at timestamp
  connected_at timestamp
  indexes {
    (store_id, status)
  }
}

Table carrier_zones {
  id bigint [pk, increment]
  connection_id bigint [ref: > carrier_connections.id, not null]
  remote_id varchar [not null]
  name varchar [not null]
  parent_name varchar
  is_shipping boolean [default: false]
  is_active boolean [default: true]
  synced_at timestamp
  indexes {
    (connection_id, remote_id) [unique]
  }
  Note: 'Copie des zones du transporteur (GET /zones), rafraîchie chaque jour.'
}

Table carrier_zone_mappings {
  id bigint [pk, increment]
  connection_id bigint [ref: > carrier_connections.id, not null]
  place_id bigint [ref: > places.id, not null]
  carrier_zone_id bigint [ref: > carrier_zones.id, note: 'null = lieu non couvert par ce transporteur']
  matched_by varchar(10) [not null, note: 'auto | manual']
  indexes {
    (connection_id, place_id) [unique]
  }
}

Table carrier_product_mappings {
  id bigint [pk, increment]
  connection_id bigint [ref: > carrier_connections.id, not null]
  variant_id bigint [ref: > product_variants.id, not null]
  remote_product_id varchar [not null]
  remote_sku varchar
  remote_on_hand int [note: 'dernier stock lu chez le transporteur']
  synced_at timestamp
  indexes {
    (connection_id, variant_id) [unique]
    (connection_id, remote_product_id) [unique]
  }
}

Table carrier_webhook_receipts {
  id bigint [pk, increment]
  connection_id bigint [ref: > carrier_connections.id, not null]
  webhook_id varchar [not null, note: 'en-tête X-Webhook-Id']
  event varchar(40) [not null]
  payload jsonb [not null]
  received_at timestamp [not null]
  processed_at timestamp
  error varchar
  indexes {
    (connection_id, webhook_id) [unique]
  }
}

Table carrier_payouts {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  connection_id bigint [ref: > carrier_connections.id, not null]
  remote_id varchar [not null]
  amount int [not null, note: 'net versé par le transporteur']
  total_collected int
  total_fees int
  method varchar(20)
  transaction_ref varchar
  paid_at timestamp
  reconciliation_status varchar(20) [not null, default: 'pending', note: 'pending | matched | discrepancy']
  difference int [default: 0, note: 'net reçu − net attendu']
  raw jsonb
  indexes {
    (connection_id, remote_id) [unique]
  }
}

Table carrier_payout_lines {
  id bigint [pk, increment]
  carrier_payout_id bigint [ref: > carrier_payouts.id, not null]
  shipment_id bigint [ref: > shipments.id, note: 'null = course inconnue de la boutique (écart)']
  remote_tracking_code varchar(40) [not null]
  collected int [not null]
  fees int [not null]
  net int [not null]
  expected_net int [note: 'calculé depuis l’expédition']
  difference int
}

// ═════════════════════════════ FINANCES ═════════════════════════════

Table ledger_entries {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  transaction_id uuid [not null, note: 'les écritures d’une même opération s’équilibrent (débit = crédit)']
  account varchar(30) [not null, note: 'sales | shipping_income | discounts | cash_on_hand | courier_cash | carrier_receivable | provider_receivable | bank | refunds | shipping_costs | courier_pay | payment_fees | expenses | cash_differences']
  debit int [not null, default: 0]
  credit int [not null, default: 0]
  courier_id bigint [ref: > couriers.id, note: 'sous-compte (argent détenu par un livreur)']
  carrier_connection_id bigint [ref: > carrier_connections.id, note: 'sous-compte (à recevoir d’un transporteur)']
  payment_account_id bigint [ref: > payment_accounts.id, note: 'sous-compte (à recevoir d’un prestataire)']
  reference_type varchar(30) [note: 'order | payment | shipment | courier_remittance | carrier_payout | expense | refund']
  reference_id bigint
  description varchar
  occurred_at timestamp [not null]
  created_by bigint [ref: > users.id]
  created_at timestamp [not null]
  indexes {
    (store_id, account, occurred_at)
    (transaction_id)
    (reference_type, reference_id)
  }
  Note: 'Journal en partie double simplifiée : les soldes (argent chez chaque livreur, à recevoir de chaque transporteur) se calculent, ils ne sont jamais stockés.'
}

Table expenses {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  category varchar(20) [not null, note: 'ads | packaging | rent | salaries | transport | other']
  amount int [not null]
  description varchar
  spent_on date [not null]
  receipt_path varchar
  ledger_transaction_id uuid
  created_by bigint [ref: > users.id]
}

Table store_daily_stats {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  date date [not null]
  orders_count int [default: 0]
  confirmed_count int [default: 0]
  delivered_count int [default: 0]
  returned_count int [default: 0]
  revenue int [default: 0]
  cost int [default: 0]
  shipping_costs int [default: 0]
  by_source jsonb [note: '{online_store: {orders, revenue}, whatsapp: …}']
  visitors int [note: 'boutique en ligne']
  indexes {
    (store_id, date) [unique]
  }
  Note: 'Agrégats recalculés la nuit (et pour le jour en cours) : tableaux de bord rapides.'
}

// ═════════════════════════════ BOUTIQUE EN LIGNE ═════════════════════════════

Table themes {
  id bigint [pk, increment]
  code varchar(30) [unique, not null]
  name varchar [not null]
  version varchar(10) [not null]
  settings_schema jsonb [not null, note: 'réglages proposés au marchand (couleurs, polices, sections)']
  preview_path varchar
  is_premium boolean [default: false]
  is_active boolean [default: true]
}

Table store_themes {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  theme_id bigint [ref: > themes.id, not null]
  settings jsonb [not null, note: 'valeurs choisies : logo, couleurs, bannières, sections de l’accueil']
  draft_settings jsonb [note: 'modifications en cours, publiées d’un clic']
  published_at timestamp
  indexes {
    (store_id, theme_id) [unique]
  }
}

Table pages {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  title varchar [not null]
  slug varchar [not null]
  body text
  is_visible boolean [default: true]
  seo_title varchar(70)
  seo_description varchar(160)
  indexes {
    (store_id, slug) [unique]
  }
}

Table menus {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  handle varchar(20) [not null, note: 'main | footer']
  items jsonb [not null, note: '[{label, type: collection|product|page|url, target, children}]']
  indexes {
    (store_id, handle) [unique]
  }
}

Table redirects {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  from_path varchar [not null]
  to_url varchar [not null]
  indexes {
    (store_id, from_path) [unique]
  }
  Note: 'Redirections 301 (produit renommé, migration depuis un autre site).'
}

Table short_links {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  code varchar(12) [unique, not null, note: '{slug}.jibiat-marchand.com/p/{code}']
  target_type varchar(20) [not null, note: 'product (V1 : collection, payment_link)']
  target_id bigint [not null]
  share_image_path varchar [note: 'image carrée prête pour les statuts WhatsApp']
  clicks int [default: 0]
}

// ═════════════════════════════ MESSAGES ET NOTIFICATIONS ═════════════════════════════

Table whatsapp_accounts {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, unique, not null]
  connection varchar(20) [not null, default: 'manual', note: 'manual | embedded (connecté en un clic via l’application Meta de la plateforme)']
  phone_number_id varchar [not null]
  waba_id varchar [note: 'indexé : notifications de l’application de la plateforme']
  display_phone varchar(20)
  access_token text [not null, note: 'chiffré']
  app_secret text [note: 'chiffré : vérifie la signature X-Hub-Signature-256 des webhooks de Meta (vide en connexion en un clic : clé de la plateforme)']
  two_step_pin text [note: 'chiffré : code PIN du numéro (connexion en un clic)']
  template_status json [note: '{événement: PENDING | APPROVED | REJECTED…}']
  verify_token varchar(64) [not null, note: 'vérification de l’URL de rappel (hub.challenge)']
  webhook_uuid uuid [unique, not null, note: 'api.jibiat-marchand.com/webhooks/whatsapp/{uuid}']
  templates jsonb [note: '{événement: nom du modèle approuvé chez Meta} ; variables dans l’ordre de CustomerMessenger::EVENTS']
  automations jsonb [note: '{événement: true | false}']
  status varchar(20) [default: 'active', note: 'active | error | disabled']
  last_error varchar
  Note: 'WhatsApp Cloud API au nom du marchand. Réponses « Confirmer / Annuler » appliquées à la commande, seulement depuis le numéro du client.'
}

Table message_templates {
  Note: 'V2 : textes personnalisés par événement. En V1, les noms des modèles Meta sont dans whatsapp_accounts.templates et les textes des liens wa.me dans le code.'
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, note: 'null = modèle par défaut de la plateforme']
  event varchar(40) [not null, note: 'order_received | order_confirm_request | order_shipped | order_delivered | payment_link | cart_recovery | delivery_code…']
  channel varchar(10) [not null, note: 'whatsapp | sms | email']
  locale varchar(5) [default: 'fr']
  body text [not null, note: 'variables {customer_name}, {order_number}, {tracking_url}…']
  meta_template_name varchar [note: 'modèle approuvé chez Meta']
  is_active boolean [default: true]
  indexes {
    (store_id, event, channel, locale) [unique]
  }
}

Table outbound_messages {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  channel varchar(10) [not null, note: 'whatsapp | whatsapp_link | sms | email']
  to_phone varchar(20)
  to_email varchar
  event varchar(40)
  body text
  related_type varchar(30) [note: 'order | cart | shipment | payment_link | customer']
  related_id bigint
  status varchar(20) [not null, note: 'queued | sent | delivered | read | failed | opened_link (lien manuel)']
  provider_message_id varchar
  error varchar
  cost int
  sent_at timestamp
  delivered_at timestamp
  read_at timestamp
  created_at timestamp [not null]
  indexes {
    (related_type, related_id)
    (store_id, created_at)
  }
}

Table conversations {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  channel varchar(20) [not null, note: 'whatsapp (puis messenger, instagram)']
  contact varchar(64) [not null, note: 'numéro +225… pour WhatsApp']
  contact_name varchar(120) [note: 'nom du profil WhatsApp']
  customer_id bigint [ref: > customers.id]
  order_id bigint [ref: > orders.id, note: 'dernière commande créée depuis la conversation']
  last_preview varchar(200)
  last_message_at timestamp
  last_inbound_at timestamp [note: 'réponse libre permise 24 h après']
  unread_count int [not null, default: 0]
  created_at timestamp [not null]
  indexes {
    (store_id, channel, contact) [unique]
    (store_id, last_message_at)
  }
  Note: 'Boîte « Messages » : un fil par client et par canal'
}

Table conversation_messages {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  conversation_id bigint [ref: > conversations.id, not null]
  direction varchar(3) [not null, note: 'in | out']
  type varchar(20) [not null, note: 'text | image | audio | video | document | location | sticker | button | interactive | template | other']
  body text
  provider_message_id varchar [note: 'wamid… (notification rejouée ignorée)']
  status varchar(20) [not null, note: 'received | sent | delivered | read | failed']
  error varchar
  user_id bigint [ref: > users.id, note: 'membre qui a répondu']
  sent_at timestamp [not null]
  created_at timestamp [not null]
  indexes {
    (conversation_id, sent_at)
    provider_message_id
  }
}

Table device_tokens {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, not null]
  token varchar(512) [unique, not null, note: 'adresse Firebase de l’appareil (application installée)']
  platform varchar(10) [not null, note: 'android | ios']
  last_seen_at timestamp [not null]
  created_at timestamp [not null]
  Note: 'Notifications push : un appareil par ligne, oublié quand Firebase le dit désinstallé'
}

Table push_subscriptions {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, not null]
  store_id bigint [ref: > stores.id, not null]
  endpoint varchar(500) [unique, not null]
  public_key varchar
  auth_token varchar
  app varchar(10) [note: 'gestion | livreur']
}

Table notification_preferences {
  id bigint [pk, increment]
  store_user_id bigint [ref: > store_users.id, not null]
  event varchar(40) [not null, note: 'new_order | order_to_confirm | delivered | failed | low_stock | payout…']
  channels jsonb [not null, note: '["in_app", "push", "whatsapp", "email"]']
  indexes {
    (store_user_id, event) [unique]
  }
}

Table scheduled_reports {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  user_id bigint [ref: > users.id, not null]
  frequency varchar(10) [not null, note: 'daily | weekly | monthly']
  channel varchar(10) [not null, note: 'whatsapp (modèle « daily_report » du WhatsApp de la boutique) | email']
  all_stores boolean [not null, default: false, note: 'rapport commun à toutes les boutiques de l\'abonnement Business (propriétaire)']
  send_at time [default: '20:00', note: 'heure de la boutique']
  last_sent_at timestamp
  is_active boolean [default: true]
}

// ═════════════════════════════ API ET WEBHOOKS DU MARCHAND (V1) ═════════════════════════════
// Mêmes structures que Delivery App (§4.5 du plan).

Table api_keys {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  name varchar(100) [not null]
  key_prefix varchar(12) [unique, not null, note: 'partie visible : jm_<prefix>_…']
  key_hash varchar(64) [not null]
  scopes jsonb [not null, note: 'products:read | products:write | orders:read | orders:write | customers:read | stock:read | stock:write']
  created_by bigint [ref: > users.id]
  last_used_at timestamp
  expires_at timestamp
  revoked_at timestamp
}

Table idempotency_keys {
  id bigint [pk, increment]
  api_key_id bigint [ref: > api_keys.id, not null]
  key varchar(100) [not null]
  request_hash varchar(64) [not null]
  response_code smallint
  response_body text
  created_at timestamp [not null]
  indexes {
    (api_key_id, key) [unique]
    created_at
  }
}

Table webhook_subscriptions {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  url varchar(500) [not null]
  events jsonb [not null, note: 'order.created | order.updated | order.cancelled | shipment.status_changed | payment.succeeded | stock.low | product.updated']
  secret text [not null, note: 'chiffré']
  is_active boolean [default: true]
  consecutive_failures int [default: 0]
  created_by bigint [ref: > users.id]
}

Table webhook_deliveries {
  id bigint [pk, increment]
  store_id bigint [ref: > stores.id, not null]
  webhook_subscription_id bigint [ref: > webhook_subscriptions.id, not null]
  event_id uuid [not null]
  event varchar(40) [not null]
  payload jsonb [not null]
  status varchar(20) [not null, default: 'pending', note: 'pending | delivered | failed']
  attempts smallint [default: 0]
  response_code smallint
  error varchar
  next_retry_at timestamp
  delivered_at timestamp
  created_at timestamp [not null]
  indexes {
    (webhook_subscription_id, created_at)
    (store_id, status)
  }
}

// ═════════════════════════════ RÉSEAU DE CONFIANCE (V2, sous réserve juridique) ═════════════════════════════

Table phone_trust_scores {
  phone_hash varchar(64) [pk, note: 'HMAC du numéro avec une clé de la plateforme : le numéro n’est pas stocké']
  delivered_count int [default: 0]
  refused_count int [default: 0]
  stores_count int [default: 0]
  updated_at timestamp
  Note: 'Alimenté uniquement par les boutiques qui l’ont accepté ; seule une note est affichée, jamais l’historique ni les boutiques.'
}

// ═════════════════════════════ GROUPES (dbdiagram) ═════════════════════════════

TableGroup plateforme {
  plans
  users
  stores
  store_users
  store_invitations
  store_domains
  slug_history
  subscriptions
  subscription_invoices
  usage_counters
  phone_verifications
  support_sessions
  admin_actions
}

TableGroup geographie {
  places
  delivery_zones
  delivery_zone_places
}

TableGroup catalogue {
  products
  product_options
  product_option_values
  product_variants
  product_images
  volume_prices
  collections
  collection_products
  tags
  taggables
}

TableGroup stock {
  stock_locations
  stock_levels
  stock_movements
  suppliers
  stock_receipts
  stock_receipt_items
  stock_transfers
  stock_transfer_items
  inventory_counts
  inventory_count_items
}

TableGroup clients {
  customers
  customer_addresses
  carts
  cart_items
}

TableGroup commandes {
  orders
  order_items
  order_events
  order_confirmations
  discounts
  discount_usages
  returns
  return_items
}

TableGroup paiements {
  payment_accounts
  payment_routes
  payments
  payment_links
  refunds
  payment_webhook_receipts
}

TableGroup expeditions {
  shipments
  shipment_items
  shipment_events
  shipment_quotes
  shipping_rules
}

TableGroup livreurs {
  couriers
  courier_zones
  courier_assignments
  delivery_runs
  delivery_run_stops
  cash_collections
  courier_remittances
  courier_pay_rules
  courier_earnings
  courier_payouts
  courier_locations
}

TableGroup transporteurs {
  carrier_connections
  carrier_zones
  carrier_zone_mappings
  carrier_product_mappings
  carrier_webhook_receipts
  carrier_payouts
  carrier_payout_lines
}

TableGroup finances {
  ledger_entries
  expenses
  store_daily_stats
}

TableGroup boutique_en_ligne {
  themes
  store_themes
  pages
  menus
  redirects
  short_links
}

TableGroup messages {
  whatsapp_accounts
  message_templates
  outbound_messages
  conversations
  conversation_messages
  device_tokens
  push_subscriptions
  notification_preferences
  scheduled_reports
}

TableGroup integrations {
  api_keys
  idempotency_keys
  webhook_subscriptions
  webhook_deliveries
  phone_trust_scores
}
