APP_NAME="Jibiat Marchand"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Domaine de la plateforme : {slug}.PLATFORM_DOMAIN pour chaque boutique.
# Production : jibiat-marchand.com. En local, *.localhost pointe vers 127.0.0.1 sans configuration DNS :
# http://localhost:8000 (présentation), http://demo.localhost:8000/gestion (boutique de démonstration).
PLATFORM_DOMAIN=localhost
# Moteurs de recherche : vide = seulement si APP_ENV=production (préproduction jamais indexée)
SEARCH_INDEXING=
# Préproduction : code d'accès demandé avant toute page (vide = site ouvert ; ignoré en production)
PREPROD_ACCESS_CODE=
PLATFORM_TRIAL_LENGTH_DAYS=30

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jibiat_marchand
DB_USERNAME=jibiat
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS de vérification des numéros : log (développement, code affiché sur la page) | twilio | none
# SMS des codes de vérification : log (journal, sans envoi), orange, twilio ou none
SMS_DRIVER=log
# Orange Developer (offre « SMS Côte d'Ivoire ») : identifiants de l'application ; nom d'expéditeur validé par Orange
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=+2250000
ORANGE_SMS_SENDER_NAME=JIBIAT
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Photos du catalogue : public (storage/app/public, « php artisan storage:link ») ou s3 en production
CATALOG_DISK=public

# Entreprises de livraison (Delivery App) que les boutiques peuvent interroger (import du catalogue, phase 4)
DELIVERY_APP_DOMAINS=jibiat.com
# Développement avec une instance locale de Delivery App : DELIVERY_APP_DOMAINS=localhost et DELIVERY_APP_SCHEME=http
DELIVERY_APP_SCHEME=https
# Course livrée non reversée par l'entreprise de livraison depuis ce nombre de jours : signalée en retard
CARRIER_PAYOUT_OVERDUE_DAYS=7

# Supervision des erreurs (sentry.io) ; vide en local
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Abonnements des boutiques : compte de la plateforme chez le prestataire (wave | cinetpay | paydunya)
BILLING_PROVIDER=wave
BILLING_MODE=live
BILLING_WAVE_API_KEY=
BILLING_WAVE_WEBHOOK_SECRET=
BILLING_CINETPAY_APIKEY=
BILLING_CINETPAY_SITE_ID=
BILLING_CINETPAY_SECRET_KEY=
BILLING_PAYDUNYA_MASTER_KEY=
BILLING_PAYDUNYA_PRIVATE_KEY=
BILLING_PAYDUNYA_TOKEN=
# Lien marchand Wave sans API (BILLING_PROVIDER=wave_link) : {montant} est remplacé par le montant de la facture.
# Chaque paiement est annoncé par SMS au validateur, qui confirme avec son code après le message de Wave.
BILLING_WAVE_LINK=
BILLING_VALIDATOR_PHONE=
BILLING_VALIDATOR_PIN=
BILLING_GRACE_DAYS=7

# Domaines personnalisés : cible CNAME et adresses IP du serveur (domaines nus)
CUSTOM_DOMAIN_CNAME=domaines.jibiat-marchand.com
CUSTOM_DOMAIN_IPS=

# Application Meta de la plateforme : bouton « Connecter WhatsApp avec Facebook » (inscription intégrée).
# Vide : seul le formulaire manuel est proposé. Webhook de l'application : https://api.<domaine>/webhooks/whatsapp
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
# Prix estimé d'un message marketing WhatsApp (F CFA), affiché avant une relance de clients
WHATSAPP_MARKETING_PRICE=15
META_WEBHOOK_VERIFY_TOKEN=
# Réseaux sociaux (Marketing › Réseaux sociaux) : même application Meta, produits « Facebook Login for Business »
# (configuration avec pages_manage_posts, pages_messaging, instagram_content_publish, instagram_manage_messages…)
# et Messenger / Instagram (webhooks page et instagram vers la même adresse que WhatsApp).
# URL de retour à déclarer chez Meta : https://<domaine>/reseaux/meta/retour
META_SOCIAL_CONFIG_ID=
# TikTok for Developers (Login Kit + Content Posting API). URL de retour : https://<domaine>/reseaux/tiktok/retour
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Notifications push de l'application (Firebase) : chemin du fichier JSON du compte de service
# (Firebase › Paramètres du projet › Comptes de service › Générer une nouvelle clé privée). Vide : pas de push.
FIREBASE_CREDENTIALS=

# Support : WhatsApp de l'équipe (bouton « Aide » de la gestion)
SUPPORT_WHATSAPP_NUMBER=+2250507016739

# Assistant IA (Claude, d'Anthropic) : clé API créée sur console.anthropic.com › API Keys. Vide : assistant désactivé.
# AI_MODEL : modèle utilisé (par défaut claude-opus-5-5 ; claude-haiku-5-5 coûte beaucoup moins cher).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Francs CFA pour un dollar, pour estimer le coût de l'IA dans la console
AI_USD_RATE=600
