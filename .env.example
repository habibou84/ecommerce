APP_NAME="Jibiat Marchand"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Domaine de la plateforme : {slug}.PLATFORM_DOMAIN pour chaque boutique.
# Production : jibiat-marchand.com. En local, *.localhost pointe vers 127.0.0.1 sans configuration DNS :
# http://localhost:8000 (présentation), http://demo.localhost:8000/gestion (boutique de démonstration).
PLATFORM_DOMAIN=localhost
# Moteurs de recherche : vide = seulement si APP_ENV=production (préproduction jamais indexée)
SEARCH_INDEXING=
# Préproduction : code d'accès demandé avant toute page (vide = site ouvert ; ignoré en production)
PREPROD_ACCESS_CODE=
PLATFORM_TRIAL_DAYS=14

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jibiat_marchand
DB_USERNAME=jibiat
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS de vérification des numéros : log (développement, code affiché sur la page) | twilio | none
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Photos du catalogue : public (storage/app/public, « php artisan storage:link ») ou s3 en production
CATALOG_DISK=public

# Entreprises de livraison (Delivery App) que les boutiques peuvent interroger (import du catalogue, phase 4)
DELIVERY_APP_DOMAINS=jibiat.com
# Développement avec une instance locale de Delivery App : DELIVERY_APP_DOMAINS=localhost et DELIVERY_APP_SCHEME=http
DELIVERY_APP_SCHEME=https
# Course livrée non reversée par l'entreprise de livraison depuis ce nombre de jours : signalée en retard
CARRIER_PAYOUT_OVERDUE_DAYS=7

# Supervision des erreurs (sentry.io) ; vide en local
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Abonnements des boutiques : compte de la plateforme chez le prestataire (wave | cinetpay | paydunya)
BILLING_PROVIDER=wave
BILLING_MODE=live
BILLING_WAVE_API_KEY=
BILLING_WAVE_WEBHOOK_SECRET=
BILLING_CINETPAY_APIKEY=
BILLING_CINETPAY_SITE_ID=
BILLING_CINETPAY_SECRET_KEY=
BILLING_PAYDUNYA_MASTER_KEY=
BILLING_PAYDUNYA_PRIVATE_KEY=
BILLING_PAYDUNYA_TOKEN=
BILLING_GRACE_DAYS=7

# Domaines personnalisés : cible CNAME et adresses IP du serveur (domaines nus)
CUSTOM_DOMAIN_CNAME=domaines.jibiat-marchand.com
CUSTOM_DOMAIN_IPS=

# Application Meta de la plateforme : bouton « Connecter WhatsApp avec Facebook » (inscription intégrée).
# Vide : seul le formulaire manuel est proposé. Webhook de l'application : https://api.<domaine>/webhooks/whatsapp
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Notifications push de l'application (Firebase) : chemin du fichier JSON du compte de service
# (Firebase › Paramètres du projet › Comptes de service › Générer une nouvelle clé privée). Vide : pas de push.
FIREBASE_CREDENTIALS=

# Support : WhatsApp de l'équipe (bouton « Aide » de la gestion)
SUPPORT_WHATSAPP=+2250700000000
